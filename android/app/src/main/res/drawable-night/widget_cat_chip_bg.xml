<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#4DFFFFFF">
    <item>
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="15dp" />
                    <gradient
                        android:startColor="#521E293B"
                        android:endColor="#300F172A"
                        android:angle="135" />
                    <stroke
                        android:width="1dp"
                        android:color="#52FFFFFF" />
                </shape>
            </item>
            <item
                android:top="1dp"
                android:left="1dp"
                android:right="1dp"
                android:bottom="1dp">
                <shape android:shape="rectangle">
                    <corners android:radius="14dp" />
                    <gradient
                        android:startColor="#29FFFFFF"
                        android:endColor="#00FFFFFF"
                        android:angle="135" />
                </shape>
            </item>
        </layer-list>
    </item>
</ripple>
