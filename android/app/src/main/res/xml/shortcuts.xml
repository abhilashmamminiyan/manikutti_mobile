<?xml version="1.0" encoding="utf-8"?>
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Static Shortcut: Voice Expense -->
    <shortcut
        android:shortcutId="voice_expense"
        android:enabled="true"
        android:icon="@drawable/ic_tile_mic"
        android:shortcutShortLabel="@string/shortcut_voice_short"
        android:shortcutLongLabel="@string/shortcut_voice_long">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="com.abhilash.manikutti"
            android:targetClass="com.abhilash.manikutti.VoiceDialogActivity"
            android:data="manikutti://voice-dialog" />
        <capability-binding android:key="actions.intent.OPEN_APP_FEATURE">
            <parameter-binding
                android:key="feature"
                android:value="@array/voice_feature_synonyms" />
        </capability-binding>
    </shortcut>

    <!-- Static Shortcut: Add Expense Form -->
    <shortcut
        android:shortcutId="add_expense"
        android:enabled="true"
        android:icon="@drawable/ic_widget_add"
        android:shortcutShortLabel="@string/shortcut_add_short"
        android:shortcutLongLabel="@string/shortcut_add_long">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="com.abhilash.manikutti"
            android:targetClass="com.abhilash.manikutti.MainActivity"
            android:data="manikutti://add-transaction" />
        <capability-binding android:key="actions.intent.OPEN_APP_FEATURE">
            <parameter-binding
                android:key="feature"
                android:value="@array/add_feature_synonyms" />
        </capability-binding>
    </shortcut>

    <!-- Google Assistant Capability: Open App Feature (Hey Google, open Voice Expense in Manikutti) -->
    <capability android:name="actions.intent.OPEN_APP_FEATURE">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="com.abhilash.manikutti"
            android:targetClass="com.abhilash.manikutti.VoiceDialogActivity"
            android:data="manikutti://voice-dialog">
            <parameter
                android:name="feature"
                android:key="feature" />
        </intent>
    </capability>

    <!-- Google Assistant Custom Voice Action / Built-in Intent: Create Item -->
    <capability android:name="actions.intent.CREATE_ITEM">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="com.abhilash.manikutti"
            android:targetClass="com.abhilash.manikutti.VoiceDialogActivity"
            android:data="manikutti://voice-dialog?query={query}">
            <parameter
                android:name="item.name"
                android:key="query"/>
        </intent>
    </capability>
</shortcuts>
