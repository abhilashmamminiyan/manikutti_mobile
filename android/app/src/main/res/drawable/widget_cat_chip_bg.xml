<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#407C3AED">
    <item>
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="15dp" />
                    <solid android:color="#00000000" />
                    <stroke
                        android:width="1dp"
                        android:color="#1A000000" />
                </shape>
            </item>
            <item
                android:top="1dp"
                android:left="1dp"
                android:right="1dp"
                android:bottom="1dp">
                <shape android:shape="rectangle">
                    <corners android:radius="14dp" />
                    <gradient
                        android:startColor="#99FFFFFF"
                        android:endColor="#52FFFFFF"
                        android:angle="135" />
                    <stroke
                        android:width="1dp"
                        android:color="#E0FFFFFF" />
                </shape>
            </item>
        </layer-list>
    </item>
</ripple>
