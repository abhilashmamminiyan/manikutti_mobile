<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#66FFFFFF">
    <item>
        <layer-list>
            <!-- Translucent glowing violet glass gradient -->
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="15dp" />
                    <gradient
                        android:startColor="#D9A855F7"
                        android:endColor="#EB7C3AED"
                        android:angle="135" />
                    <stroke
                        android:width="1dp"
                        android:color="#B8FFFFFF" />
                </shape>
            </item>
            <!-- Specular top reflection -->
            <item
                android:top="1dp"
                android:left="1dp"
                android:right="1dp"
                android:bottom="1dp">
                <shape android:shape="rectangle">
                    <corners android:radius="14dp" />
                    <gradient
                        android:startColor="#48FFFFFF"
                        android:endColor="#00FFFFFF"
                        android:angle="270" />
                </shape>
            </item>
        </layer-list>
    </item>
</ripple>
