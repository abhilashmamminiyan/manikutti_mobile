<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Subtle outer rim so glass edge holds shape on bright wallpapers -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="20dp" />
            <solid android:color="#00000000" />
            <stroke
                android:width="1dp"
                android:color="#1A000000" />
        </shape>
    </item>
    <!-- Frosted translucent glass capsule -->
    <item
        android:top="1dp"
        android:left="1dp"
        android:right="1dp"
        android:bottom="1dp">
        <shape android:shape="rectangle">
            <corners android:radius="19dp" />
            <gradient
                android:startColor="#9EFFFFFF"
                android:endColor="#5EFFFFFF"
                android:angle="135" />
            <stroke
                android:width="1dp"
                android:color="#EBFFFFFF" />
        </shape>
    </item>
</layer-list>
