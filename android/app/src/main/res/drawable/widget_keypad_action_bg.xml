<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#407C3AED">
    <item>
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="14dp" />
                    <solid android:color="#00000000" />
                    <stroke
                        android:width="1dp"
                        android:color="#1F4C1D95" />
                </shape>
            </item>
            <!-- Soft lavender-tinted frosted glass for presets & utility keys -->
            <item
                android:top="1dp"
                android:left="1dp"
                android:right="1dp"
                android:bottom="1dp">
                <shape android:shape="rectangle">
                    <corners android:radius="13dp" />
                    <gradient
                        android:startColor="#99F3E8FF"
                        android:endColor="#5EE9D5FF"
                        android:angle="135" />
                    <stroke
                        android:width="1dp"
                        android:color="#E0FFFFFF" />
                </shape>
            </item>
            <item
                android:top="2dp"
                android:left="2dp"
                android:right="2dp"
                android:bottom="2dp">
                <shape android:shape="rectangle">
                    <corners android:radius="12dp" />
                    <gradient
                        android:startColor="#38FFFFFF"
                        android:endColor="#00FFFFFF"
                        android:angle="270" />
                </shape>
            </item>
        </layer-list>
    </item>
</ripple>
