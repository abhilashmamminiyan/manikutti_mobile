<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Ambient edge contour -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <solid android:color="#00000000" />
            <stroke
                android:width="1dp"
                android:color="#1A000000" />
        </shape>
    </item>
    <!-- Frosted crystal display card -->
    <item
        android:top="1dp"
        android:left="1dp"
        android:right="1dp"
        android:bottom="1dp">
        <shape android:shape="rectangle">
            <corners android:radius="17dp" />
            <gradient
                android:startColor="#B8FFFFFF"
                android:centerColor="#8CFFFFFF"
                android:endColor="#66FFFFFF"
                android:angle="135" />
            <stroke
                android:width="1dp"
                android:color="#F2FFFFFF" />
        </shape>
    </item>
    <!-- Top specular glass highlight -->
    <item
        android:top="2dp"
        android:left="2dp"
        android:right="2dp"
        android:bottom="2dp">
        <shape android:shape="rectangle">
            <corners android:radius="15dp" />
            <gradient
                android:startColor="#48FFFFFF"
                android:endColor="#00FFFFFF"
                android:angle="270" />
        </shape>
    </item>
</layer-list>
