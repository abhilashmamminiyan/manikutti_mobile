<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_card_bg"
    android:padding="14dp"
    android:gravity="center_vertical">

    <!-- Top Row: Month Expense Info & Action Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- Spending Details -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_month_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Manikutti • October"
                android:textColor="#94A3B8"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.05"
                android:textAllCaps="true" />

            <TextView
                android:id="@+id/widget_total_expense"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="₹0"
                android:textColor="#F8FAFC"
                android:textSize="22sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Action Buttons: Plus & Voice Mic -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Plus Button -->
            <ImageButton
                android:id="@+id/widget_btn_add"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/widget_btn_add_bg"
                android:src="@drawable/ic_widget_add"
                android:padding="8dp"
                android:contentDescription="Add Expense" />

            <!-- Voice Mic Button -->
            <ImageButton
                android:id="@+id/widget_btn_mic"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/widget_btn_mic_bg"
                android:src="@drawable/ic_tile_mic"
                android:padding="10dp"
                android:contentDescription="Voice Expense" />
        </LinearLayout>
    </LinearLayout>

    <!-- Bottom Alert Row: Pending Recharge or Utility Bill -->
    <LinearLayout
        android:id="@+id/widget_alert_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/widget_alert_bg"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/ic_widget_bill"
            android:contentDescription="Bill Alert" />

        <TextView
            android:id="@+id/widget_pending_bill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="No pending bills"
            android:textColor="#FDBA74"
            android:textSize="12sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />
    </LinearLayout>
</LinearLayout>
