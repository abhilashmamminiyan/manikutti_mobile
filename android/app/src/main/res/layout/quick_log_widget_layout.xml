<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/quick_log_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@android:color/transparent"
    android:padding="8dp"
    android:gravity="center">

    <!-- Top Floating Glass Header Pills -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingBottom="6dp">

        <TextView
            android:id="@+id/quick_log_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_glass_pill_bg"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:text="MANIKUTTI • QUICK"
            android:textColor="@color/widget_glass_text_secondary"
            android:textSize="10sp"
            android:textStyle="bold"
            android:letterSpacing="0.06"
            android:shadowColor="@color/widget_glass_text_shadow"
            android:shadowDx="0"
            android:shadowDy="1"
            android:shadowRadius="2" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/quick_log_month_total"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_glass_pill_bg"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:text="Month: ₹0"
            android:textColor="@color/widget_glass_month_text"
            android:textSize="10sp"
            android:textStyle="bold"
            android:shadowColor="@color/widget_glass_text_shadow"
            android:shadowDx="0"
            android:shadowDy="1"
            android:shadowRadius="2" />
    </LinearLayout>

    <!-- Frosted Glass Digital Display Card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/widget_display_card_bg"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="7dp"
        android:paddingBottom="7dp"
        android:layout_marginBottom="6dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/quick_log_display"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="₹ 0"
                android:textColor="@color/widget_glass_text_primary"
                android:textSize="22sp"
                android:textStyle="bold"
                android:shadowColor="@color/widget_glass_text_shadow"
                android:shadowDx="0"
                android:shadowDy="1"
                android:shadowRadius="2" />

            <TextView
                android:id="@+id/quick_log_active_category"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Food"
                android:textColor="@color/widget_glass_cat_active_text"
                android:textSize="11sp"
                android:textStyle="bold"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:background="@drawable/widget_cat_chip_active_bg" />
        </LinearLayout>

        <TextView
            android:id="@+id/quick_log_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text=""
            android:textColor="@color/widget_glass_status_text"
            android:textSize="10sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Floating Glass Category Selector Strip -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="30dp"
        android:orientation="horizontal"
        android:layout_marginBottom="6dp">

        <Button
            android:id="@+id/btn_cat_1"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="5dp"
            android:background="@drawable/widget_cat_chip_active_bg"
            android:text="Food"
            android:textAllCaps="false"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="@color/widget_glass_cat_active_text"
            android:textSize="11sp"
            android:textStyle="bold"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:paddingTop="0dp"
            android:paddingBottom="0dp" />

        <Button
            android:id="@+id/btn_cat_2"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="5dp"
            android:background="@drawable/widget_cat_chip_bg"
            android:text="Fuel"
            android:textAllCaps="false"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="@color/widget_glass_text_secondary"
            android:textSize="11sp"
            android:textStyle="bold"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:paddingTop="0dp"
            android:paddingBottom="0dp" />

        <Button
            android:id="@+id/btn_cat_3"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="5dp"
            android:background="@drawable/widget_cat_chip_bg"
            android:text="Shop"
            android:textAllCaps="false"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="@color/widget_glass_text_secondary"
            android:textSize="11sp"
            android:textStyle="bold"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:paddingTop="0dp"
            android:paddingBottom="0dp" />

        <Button
            android:id="@+id/btn_cat_more"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/widget_cat_chip_bg"
            android:text="More ▾"
            android:textAllCaps="false"
            android:maxLines="1"
            android:textColor="@color/widget_glass_accent_text"
            android:textSize="11sp"
            android:textStyle="bold"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:paddingTop="0dp"
            android:paddingBottom="0dp" />
    </LinearLayout>

    <!-- Transparent Keypad Grid with Floating Glassmorphism Keys -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:background="@android:color/transparent">

        <!-- Row 1: 1, 2, 3, +50 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:layout_marginBottom="5dp">

            <Button
                android:id="@+id/btn_key_1"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginEnd="5dp"
                android:background="@drawable/widget_keypad_btn_bg"
                android:text="1"
                android:textColor="@color/widget_glass_text_primary"
                android:textSize="15sp"
                android:textStyle="bold"
                android:shadowColor="@color/widget_glass_text_shadow"
                android:shadowDx="0"
                android:shadowDy="1"
                android:shadowRadius="2"
                android:padding="0dp" />

            <Button
                android:id="@+id/btn_key_2"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginEnd="5dp"
                android:background="@drawable/widget_keypad_btn_bg"
                android:text="2"
                android:textColor="@color/widget_glass_text_primary"
                android:textSize="15sp"
                android:textStyle="bold"
                android:shadowColor="@color/widget_glass_text_shadow"
                android:shadowDx="0"
                android:shadowDy="1"
                android:shadowRadius="2"
                android:padding="0dp" />

            <Button
                android:id="@+id/btn_key_3"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginEnd="5dp"
                android:background="@drawable/widget_keypad_btn_bg"
                android:text="3"
                android:textColor="@color/widget_glass_text_primary"
                android:textSize="15sp"
                android:textStyle="bold"
                android:shadowColor="@color/widget_glass_text_shadow"
                android:shadowDx="0"
                android:shadowDy="1"
                android:shadowRadius="2"
                android:padding="0dp" />

            <Button
                android:id="@+id/btn_key_p50"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1.15"
                android:background="@drawable/widget_keypad_action_bg"
                android:text="+50"
                android:textAllCaps="false"
                android:textColor="@color/widget_glass_accent_text"
                android:textSize="12sp"
                android:textStyle="bold"
                android:shadowColor="@color/widget_glass_text_shadow"
                android:shadowDx="0"
                android:shadowDy="1"
                android:shadowRadius="2"
                android:padding="0dp" />
        </LinearLayout>

        <!-- Row 2: 4, 5, 6, +100 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:layout_marginBottom="5dp">

            <Button
                android:id="@+id/btn_key_4"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginEnd="5dp"
                android:background="@drawable/widget_keypad_btn_bg"
                android:text="4"
                android:textColor="@color/widget_glass_text_primary"
                android:textSize="15sp"
                android:textStyle="bold"
                android:shadowColor="@color/widget_glass_text_shadow"
                android:shadowDx="0"
                android:shadowDy="1"
                android:shadowRadius="2"
                android:padding="0dp" />

            <Button
                android:id="@+id/btn_key_5"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginEnd="5dp"
                android:background="@drawable/widget_keypad_btn_bg"
                android:text="5"
                android:textColor="@color/widget_glass_text_primary"
                android:textSize="15sp"
                android:textStyle="bold"
                android:shadowColor="@color/widget_glass_text_shadow"
                android:shadowDx="0"
                android:shadowDy="1"
                android:shadowRadius="2"
                android:padding="0dp" />

            <Button
                android:id="@+id/btn_key_6"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginEnd="5dp"
                android:background="@drawable/widget_keypad_btn_bg"
                android:text="6"
                android:textColor="@color/widget_glass_text_primary"
                android:textSize="15sp"
                android:textStyle="bold"
                android:shadowColor="@color/widget_glass_text_shadow"
                android:shadowDx="0"
                android:shadowDy="1"
                android:shadowRadius="2"
                android:padding="0dp" />

            <Button
                android:id="@+id/btn_key_p100"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1.15"
                android:background="@drawable/widget_keypad_action_bg"
                android:text="+100"
                android:textAllCaps="false"
                android:textColor="@color/widget_glass_accent_text"
                android:textSize="12sp"
                android:textStyle="bold"
                android:shadowColor="@color/widget_glass_text_shadow"
                android:shadowDx="0"
                android:shadowDy="1"
                android:shadowRadius="2"
                android:padding="0dp" />
        </LinearLayout>

        <!-- Row 3: 7, 8, 9, +500 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:layout_marginBottom="5dp">

            <Button
                android:id="@+id/btn_key_7"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginEnd="5dp"
                android:background="@drawable/widget_keypad_btn_bg"
                android:text="7"
                android:textColor="@color/widget_glass_text_primary"
                android:textSize="15sp"
                android:textStyle="bold"
                android:shadowColor="@color/widget_glass_text_shadow"
                android:shadowDx="0"
                android:shadowDy="1"
                android:shadowRadius="2"
                android:padding="0dp" />

            <Button
                android:id="@+id/btn_key_8"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginEnd="5dp"
                android:background="@drawable/widget_keypad_btn_bg"
                android:text="8"
                android:textColor="@color/widget_glass_text_primary"
                android:textSize="15sp"
                android:textStyle="bold"
                android:shadowColor="@color/widget_glass_text_shadow"
                android:shadowDx="0"
                android:shadowDy="1"
                android:shadowRadius="2"
                android:padding="0dp" />

            <Button
                android:id="@+id/btn_key_9"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginEnd="5dp"
                android:background="@drawable/widget_keypad_btn_bg"
                android:text="9"
                android:textColor="@color/widget_glass_text_primary"
                android:textSize="15sp"
                android:textStyle="bold"
                android:shadowColor="@color/widget_glass_text_shadow"
                android:shadowDx="0"
                android:shadowDy="1"
                android:shadowRadius="2"
                android:padding="0dp" />

            <Button
                android:id="@+id/btn_key_p500"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1.15"
                android:background="@drawable/widget_keypad_action_bg"
                android:text="+500"
                android:textAllCaps="false"
                android:textColor="@color/widget_glass_accent_text"
                android:textSize="12sp"
                android:textStyle="bold"
                android:shadowColor="@color/widget_glass_text_shadow"
                android:shadowDx="0"
                android:shadowDy="1"
                android:shadowRadius="2"
                android:padding="0dp" />
        </LinearLayout>

        <!-- Row 4: C, 0, ⌫, ✓ SAVE -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_key_clear"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginEnd="5dp"
                android:background="@drawable/widget_keypad_action_bg"
                android:text="C"
                android:textColor="@color/widget_glass_clear_text"
                android:textSize="14sp"
                android:textStyle="bold"
                android:shadowColor="@color/widget_glass_text_shadow"
                android:shadowDx="0"
                android:shadowDy="1"
                android:shadowRadius="2"
                android:padding="0dp" />

            <Button
                android:id="@+id/btn_key_0"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginEnd="5dp"
                android:background="@drawable/widget_keypad_btn_bg"
                android:text="0"
                android:textColor="@color/widget_glass_text_primary"
                android:textSize="15sp"
                android:textStyle="bold"
                android:shadowColor="@color/widget_glass_text_shadow"
                android:shadowDx="0"
                android:shadowDy="1"
                android:shadowRadius="2"
                android:padding="0dp" />

            <Button
                android:id="@+id/btn_key_backspace"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginEnd="5dp"
                android:background="@drawable/widget_keypad_action_bg"
                android:text="⌫"
                android:textColor="@color/widget_glass_backspace_text"
                android:textSize="14sp"
                android:textStyle="bold"
                android:shadowColor="@color/widget_glass_text_shadow"
                android:shadowDx="0"
                android:shadowDy="1"
                android:shadowRadius="2"
                android:padding="0dp" />

            <Button
                android:id="@+id/btn_key_save"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1.15"
                android:background="@drawable/widget_keypad_save_bg"
                android:text="✓ Save"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold"
                android:padding="0dp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
