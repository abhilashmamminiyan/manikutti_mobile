<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/quick_log_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_card_bg"
    android:padding="10dp"
    android:gravity="center">

    <!-- Top Header Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingBottom="6dp">

        <TextView
            android:id="@+id/quick_log_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="MANIKUTTI • QUICK LOG"
            android:textColor="#94A3B8"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.06" />

        <TextView
            android:id="@+id/quick_log_month_total"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Month: ₹0"
            android:textColor="#FDBA74"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Digital Display Screen -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/widget_display_card_bg"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingTop="5dp"
        android:paddingBottom="5dp"
        android:layout_marginBottom="6dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/quick_log_display"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="₹ 0"
                android:textColor="#F8FAFC"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/quick_log_active_category"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Food"
                android:textColor="#2DD4BF"
                android:textSize="12sp"
                android:textStyle="bold"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="3dp"
                android:paddingBottom="3dp"
                android:background="@drawable/widget_cat_chip_active_bg" />
        </LinearLayout>

        <TextView
            android:id="@+id/quick_log_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="#34D399"
            android:textSize="10sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Category Selector Strip -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="28dp"
        android:orientation="horizontal"
        android:layout_marginBottom="6dp">

        <Button
            android:id="@+id/btn_cat_1"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="3dp"
            android:background="@drawable/widget_cat_chip_active_bg"
            android:text="Food"
            android:textColor="#FFFFFF"
            android:textSize="10sp"
            android:textStyle="bold"
            android:padding="0dp" />

        <Button
            android:id="@+id/btn_cat_2"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="3dp"
            android:background="@drawable/widget_cat_chip_bg"
            android:text="Fuel"
            android:textColor="#94A3B8"
            android:textSize="10sp"
            android:textStyle="bold"
            android:padding="0dp" />

        <Button
            android:id="@+id/btn_cat_3"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="3dp"
            android:background="@drawable/widget_cat_chip_bg"
            android:text="Shop"
            android:textColor="#94A3B8"
            android:textSize="10sp"
            android:textStyle="bold"
            android:padding="0dp" />

        <Button
            android:id="@+id/btn_cat_more"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/widget_cat_chip_bg"
            android:text="More ▾"
            android:textColor="#38BDF8"
            android:textSize="10sp"
            android:textStyle="bold"
            android:padding="0dp" />
    </LinearLayout>

    <!-- Interactive Keypad Grid -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- Row 1: 1, 2, 3, +50 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:layout_marginBottom="4dp">

            <Button
                android:id="@+id/btn_key_1"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:background="@drawable/widget_keypad_btn_bg"
                android:text="1"
                android:textColor="#F8FAFC"
                android:textSize="14sp"
                android:textStyle="bold"
                android:padding="0dp" />

            <Button
                android:id="@+id/btn_key_2"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:background="@drawable/widget_keypad_btn_bg"
                android:text="2"
                android:textColor="#F8FAFC"
                android:textSize="14sp"
                android:textStyle="bold"
                android:padding="0dp" />

            <Button
                android:id="@+id/btn_key_3"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:background="@drawable/widget_keypad_btn_bg"
                android:text="3"
                android:textColor="#F8FAFC"
                android:textSize="14sp"
                android:textStyle="bold"
                android:padding="0dp" />

            <Button
                android:id="@+id/btn_key_p50"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1.1"
                android:background="@drawable/widget_keypad_action_bg"
                android:text="+50"
                android:textColor="#38BDF8"
                android:textSize="12sp"
                android:textStyle="bold"
                android:padding="0dp" />
        </LinearLayout>

        <!-- Row 2: 4, 5, 6, +100 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:layout_marginBottom="4dp">

            <Button
                android:id="@+id/btn_key_4"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:background="@drawable/widget_keypad_btn_bg"
                android:text="4"
                android:textColor="#F8FAFC"
                android:textSize="14sp"
                android:textStyle="bold"
                android:padding="0dp" />

            <Button
                android:id="@+id/btn_key_5"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:background="@drawable/widget_keypad_btn_bg"
                android:text="5"
                android:textColor="#F8FAFC"
                android:textSize="14sp"
                android:textStyle="bold"
                android:padding="0dp" />

            <Button
                android:id="@+id/btn_key_6"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:background="@drawable/widget_keypad_btn_bg"
                android:text="6"
                android:textColor="#F8FAFC"
                android:textSize="14sp"
                android:textStyle="bold"
                android:padding="0dp" />

            <Button
                android:id="@+id/btn_key_p100"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1.1"
                android:background="@drawable/widget_keypad_action_bg"
                android:text="+100"
                android:textColor="#38BDF8"
                android:textSize="12sp"
                android:textStyle="bold"
                android:padding="0dp" />
        </LinearLayout>

        <!-- Row 3: 7, 8, 9, +500 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:layout_marginBottom="4dp">

            <Button
                android:id="@+id/btn_key_7"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:background="@drawable/widget_keypad_btn_bg"
                android:text="7"
                android:textColor="#F8FAFC"
                android:textSize="14sp"
                android:textStyle="bold"
                android:padding="0dp" />

            <Button
                android:id="@+id/btn_key_8"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:background="@drawable/widget_keypad_btn_bg"
                android:text="8"
                android:textColor="#F8FAFC"
                android:textSize="14sp"
                android:textStyle="bold"
                android:padding="0dp" />

            <Button
                android:id="@+id/btn_key_9"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:background="@drawable/widget_keypad_btn_bg"
                android:text="9"
                android:textColor="#F8FAFC"
                android:textSize="14sp"
                android:textStyle="bold"
                android:padding="0dp" />

            <Button
                android:id="@+id/btn_key_p500"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1.1"
                android:background="@drawable/widget_keypad_action_bg"
                android:text="+500"
                android:textColor="#38BDF8"
                android:textSize="12sp"
                android:textStyle="bold"
                android:padding="0dp" />
        </LinearLayout>

        <!-- Row 4: C, 0, ⌫, ✓ SAVE -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_key_clear"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:background="@drawable/widget_keypad_action_bg"
                android:text="C"
                android:textColor="#F87171"
                android:textSize="14sp"
                android:textStyle="bold"
                android:padding="0dp" />

            <Button
                android:id="@+id/btn_key_0"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:background="@drawable/widget_keypad_btn_bg"
                android:text="0"
                android:textColor="#F8FAFC"
                android:textSize="14sp"
                android:textStyle="bold"
                android:padding="0dp" />

            <Button
                android:id="@+id/btn_key_backspace"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:background="@drawable/widget_keypad_action_bg"
                android:text="⌫"
                android:textColor="#FDBA74"
                android:textSize="14sp"
                android:textStyle="bold"
                android:padding="0dp" />

            <Button
                android:id="@+id/btn_key_save"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1.1"
                android:background="@drawable/widget_keypad_save_bg"
                android:text="✓ SAVE"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold"
                android:padding="0dp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>